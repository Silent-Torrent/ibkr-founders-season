{
  "name": "ibkr-founders-season",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "measure:parser-memory": "node --expose-gc scripts/measure-parser-memory.mjs",
    "test:parser": "node scripts/smoke-parser.mjs",
    "test:streaming": "node scripts/test-csv-streaming.mjs",
    "test:materialization": "node scripts/test-parser-materialization.mjs",
    "test:worker": "node scripts/test-worker-boundary.mjs",
    "test:i18n": "node scripts/test-i18n-contract.mjs",
    "test:a11y": "node scripts/test-accessibility-contract.mjs",
    "test:compat": "node scripts/test-browser-compatibility-contract.mjs",
    "test:policy": "node scripts/test-product-policy.mjs",
    "test:launchers": "node scripts/test-mac-launchers.mjs",
    "prepare:iphone-stress-pack": "node scripts/generate-iphone-stress-pack.mjs",
    "verify:iphone-stress-pack": "node scripts/verify-iphone-stress-pack.mjs",
    "test:iphone-stress-pack": "node scripts/test-iphone-stress-pack.mjs",
    "test:browser": "node scripts/test-browser-import.mjs",
    "verify:private-statement": "node scripts/verify-private-statement.mjs",
    "check": "npm run typecheck && npm run test:parser && npm run test:streaming && npm run test:materialization && npm run test:worker && npm run test:i18n && npm run test:a11y && npm run test:compat && npm run test:policy && npm run test:launchers && npm run test:iphone-stress-pack && npm run test:browser"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.0",
    "typescript": "6.0.2",
    "vite": "8.2.2"
  }
}
